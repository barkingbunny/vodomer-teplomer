# Vodomer-teplomer: M5Stack Basic (ESP32 rev 1.0, 4 MB flash, bez PSRAM).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# M5GFX/M5Unified ocekavaji tick 1 ms.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Kratke probuzeni: bootloader bez kontroly obrazu po deep sleep, tichy log IDF.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Jako drive v PlatformIO: monitor nedrzi DTR/RTS (jinak reset = studeny start).
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
